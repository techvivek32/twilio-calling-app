# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/twilio_call

# Session signing secret (JWT)
AUTH_SECRET=replace-me

# AES-256-GCM key for encrypting Twilio secrets at rest (64 hex chars)
APP_ENCRYPTION_KEY=replace-me

# Seed admin (used by: npm run seed) — choose your own password, seeding
# refuses to run without one.
SEED_ADMIN_EMAIL=admin@businessconnect.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
